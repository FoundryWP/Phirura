<Page
    x:Class="Phirura.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Phirura"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#FF0E0E13">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="16,14,16,8">
            <TextBlock Text="Phirura" FontSize="30" FontWeight="Light" Foreground="#FFF2F2F6" />
            <TextBlock x:Name="SubtitleText" Text="Phira chart player for Windows Phone 8.1"
                       FontSize="12" Foreground="#FF8A8A99" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Song list -->
        <ListView x:Name="SongList" Grid.Row="1" Margin="0,4,0,4"
                  SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="SongList_ItemClick"
                  Background="Transparent">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="12,6,12,6" Padding="14,12,14,12" Background="#FF191922">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Title}" FontSize="19" Foreground="#FFF2F2F6"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#FF8A8A99"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#FF2B2B3A" Padding="10,5,10,5"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding LevelDisplay}" FontSize="14" Foreground="#FFB9B9C9" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Bottom bar -->
        <StackPanel Grid.Row="2" Margin="16,4,16,14">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="ImportButton" Content="导入谱面" Click="ImportButton_Click" />
                <Button x:Name="DeleteButton" Content="删除" Click="DeleteButton_Click" Margin="10,0,0,0" />
                <Button x:Name="RefreshButton" Content="刷新" Click="RefreshButton_Click" Margin="10,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="AccountButton" Content="账号 / 登录" Click="AccountButton_Click" />
                <Button x:Name="OnlineButton" Content="在线谱面" Click="OnlineButton_Click" Margin="10,0,0,0" />
            </StackPanel>
            <TextBlock Text="校准偏移 (毫秒)" FontSize="12" Foreground="#FF8A8A99" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="OffsetSlider" Grid.Column="0" Minimum="-300" Maximum="300"
                        StepFrequency="1" ValueChanged="OffsetSlider_ValueChanged" />
                <TextBlock x:Name="OffsetText" Grid.Column="1" Width="58" TextAlignment="Right"
                           VerticalAlignment="Center" FontSize="14" Foreground="#FFF2F2F6" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <CheckBox x:Name="AutoplayBox" Content="自动播放" Foreground="#FFB9B9C9"
                          Checked="AutoplayBox_Changed" Unchecked="AutoplayBox_Changed" />
                <CheckBox x:Name="FlipBox" Content="垂直翻转" Foreground="#FFB9B9C9" Margin="16,0,0,0"
                          Checked="FlipBox_Changed" Unchecked="FlipBox_Changed" />
            </StackPanel>
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#FF7A7A8A" Margin="0,8,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
