<Page
    x:Class="Phirura.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Phirura"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#FF0E0E13">

    <Grid Background="#FF0E0E13">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="18,16,18,8">
            <TextBlock Text="Phira 账号" FontSize="28" FontWeight="Light" Foreground="#FFF2F2F6" />
            <TextBlock Text="登录后即可浏览并下载在线谱面"
                       FontSize="12" Foreground="#FF8A8A99" Margin="0,3,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,4,18,18">

                <!-- Signed-in panel -->
                <Border x:Name="AccountPanel" Background="#FF191922" Padding="16,14,16,14"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="已登录" FontSize="12" Foreground="#FF8A8A99" />
                        <TextBlock x:Name="AccountNameText" Text="" FontSize="22"
                                   Foreground="#FFF2F2F6" Margin="0,4,0,0" />
                        <TextBlock x:Name="AccountInfoText" Text="" FontSize="12"
                                   Foreground="#FF8A8A99" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="在线谱面" Click="BrowseButton_Click" />
                            <Button Content="退出登录" Click="LogoutButton_Click" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Login form -->
                <StackPanel x:Name="FormPanel">
                    <TextBlock Text="邮箱" FontSize="12" Foreground="#FF8A8A99" />
                    <TextBox x:Name="EmailBox" InputScope="EmailSmtpAddress" Margin="0,4,0,0" />

                    <TextBlock Text="密码" FontSize="12" Foreground="#FF8A8A99" Margin="0,14,0,0" />
                    <PasswordBox x:Name="PasswordBox" Margin="0,4,0,0" />

                    <Button x:Name="LoginButton" Content="登录" Click="LoginButton_Click"
                            Margin="0,18,0,0" HorizontalAlignment="Stretch" />

                    <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="4"
                                 Foreground="#FF8FD4FF" Visibility="Collapsed" Margin="0,14,0,0" />

                    <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="#FF7A7A8A"
                               TextWrapping="Wrap" Margin="0,14,0,0" />

                    <Button Content="在浏览器中打开注册 / 找回密码" Click="RegisterButton_Click"
                            Margin="0,14,0,0" HorizontalAlignment="Left" />
                </StackPanel>

                <TextBlock Text="账号只用于浏览与下载在线谱面；登录信息保存在本机，不会上传到其他地方。"
                           FontSize="11" Foreground="#FF5A5A6A" TextWrapping="Wrap" Margin="0,18,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
