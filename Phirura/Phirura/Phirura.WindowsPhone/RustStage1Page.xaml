<Page
    x:Class="Phirura.RustStage1Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Phirura"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#FF07070B">

    <!--
        Path A, Stage 1 acceptance test.

        This is the ONLY thing the plan requires before Stage 3 may start: a textured quad drawn
        by *Rust* into a real D3D11 swapchain, attached to a real XAML SwapChainPanel, on the
        phone. Everything Stage 3 needs (device, swapchain, RTL, shaders, input layout, vertex
        buffer, sampler, blend/raster state, and a Draw call going through all of them) is
        exercised by this page - if a quad appears, the binding is proven end to end.

        SwapChainPanel is used rather than Win2D deliberately: Win2D would mean C# owns the
        device, which is exactly the design the user rejected. Here C# only hands Rust the
        panel's native pointer and drives the frame loop.
    -->
    <Grid x:Name="RootGrid" Background="#FF07070B">
        <SwapChainPanel x:Name="RustPanel" />

        <!-- HUD: what the Rust side reports, refreshed every second. -->
        <Grid IsHitTestVisible="False" Margin="14,8,14,8">
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock Text="Stage 1 · Rust D3D11" FontSize="17" Foreground="#FFF2F2F6" />
                <TextBlock x:Name="StageText" FontSize="12" Foreground="#FF8FD4FF"
                           Margin="0,4,0,0" Text="..." />
                <TextBlock x:Name="HrText" FontSize="12" Foreground="#FF9A9AAA"
                           Margin="0,2,0,0" Text="" />
                <TextBlock x:Name="SizeText" FontSize="12" Foreground="#FF9A9AAA"
                           Margin="0,2,0,0" Text="" />
                <TextBlock x:Name="VertsText" FontSize="12" Foreground="#FF9A9AAA"
                           Margin="0,2,0,0" Text="" />
                <TextBlock x:Name="FpsText" FontSize="12" Foreground="#FF9A9AAA"
                           Margin="0,2,0,0" Text="" />
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" Margin="0,0,0,14">
            <Button Content="重开" Click="RestartButton_Click" />
            <Button Content="停止" Click="StopButton_Click" Margin="10,0,0,0" />
            <Button Content="返回" Click="BackButton_Click" Margin="10,0,0,0" />
        </StackPanel>
    </Grid>
</Page>
