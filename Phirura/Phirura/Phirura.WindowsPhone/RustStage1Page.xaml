<Page
    x:Class="Phirura.RustStage1Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Phirura"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#FF07070B">

    <!--
        Path A, Stage 1 acceptance test.

        This is the ONLY thing the plan requires before Stage 3 may start: a textured quad drawn
        by *Rust* into a real D3D11 render target on the phone.

        ROUND 45 - the host element changed from SwapChainPanel to Image, because a WP8.1 *phone*
        app cannot create a swapchain at all: CreateSwapChainForCoreWindow and
        CreateSwapChainForComposition both return DXGI_ERROR_INVALID_CALL on this Adreno 225 /
        WDDM 1.2 / FL 9.3 driver, and Win2D's own ARM DLL (which renders fine here) imports no
        swapchain entry points.

        The phone path is: Rust renders into an offscreen ID3D11Texture2D and hands back a WinRT
        IDirect3DSurface + IDirect3DDevice; C# projects those through Win2D's interop statics into
        a CanvasImageSource and sets it as this Image's Source. The XAML compositor then displays
        Rust's pixels. Rust still owns the device, the texture, the pipeline and the draw calls -
        C# creates nothing but the ImageSource wrapper.
    -->
    <Grid x:Name="RootGrid" Background="#FF07070B">
        <!-- Rust's render target, composited by XAML. Stretch=None keeps it 1:1 at 96 dpi. -->
        <Image x:Name="RustImage" Stretch="Fill" Visibility="Collapsed"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- HUD: what the Rust side reports, refreshed every second. -->
        <Grid IsHitTestVisible="False" Margin="14,8,14,8">
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock Text="Stage 1 · Rust D3D11" FontSize="17" Foreground="#FFF2F2F6" />
                <TextBlock x:Name="StageText" FontSize="12" Foreground="#FF8FD4FF"
                           Margin="0,4,0,0" Text="..." />
                <TextBlock x:Name="HrText" FontSize="12" Foreground="#FF9A9AAA"
                           Margin="0,2,0,0" Text="" />
                <TextBlock x:Name="SizeText" FontSize="12" Foreground="#FF9A9AAA"
                           Margin="0,2,0,0" Text="" />
                <TextBlock x:Name="VertsText" FontSize="12" Foreground="#FF9A9AAA"
                           Margin="0,2,0,0" Text="" />
                <TextBlock x:Name="FpsText" FontSize="12" Foreground="#FF9A9AAA"
                           Margin="0,2,0,0" Text="" />
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" Margin="0,0,0,14">
            <Button Content="重开" Click="RestartButton_Click" />
            <Button Content="停止" Click="StopButton_Click" Margin="10,0,0,0" />
            <Button Content="返回" Click="BackButton_Click" Margin="10,0,0,0" />
        </StackPanel>
    </Grid>
</Page>
