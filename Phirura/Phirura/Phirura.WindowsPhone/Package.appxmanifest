<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/2010/manifest" xmlns:m2="http://schemas.microsoft.com/appx/2013/manifest" xmlns:m3="http://schemas.microsoft.com/appx/2014/manifest" xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest">

  <Identity Name="fa2c9634-5ad8-487e-be3c-9893871fda9f"
            Publisher="CN=admin"
            Version="1.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="fa2c9634-5ad8-487e-be3c-9893871fda9f" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <!-- DisplayName is what the phone shows on the tile and in the app list. The assembly is
         still Phirura.WindowsPhone; this is just the human-facing name. -->
    <DisplayName>Phirura</DisplayName>
    <PublisherDisplayName>admin</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Prerequisites>
    <OSMinVersion>6.3.1</OSMinVersion>
    <OSMaxVersionTested>6.3.1</OSMaxVersionTested>
  </Prerequisites>
  
  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
        Executable="$targetnametoken$.exe"
        EntryPoint="Phirura.WindowsPhone.App">
        <m3:VisualElements
            DisplayName="Phirura"
            Square150x150Logo="Assets\Logo.png"
            Square44x44Logo="Assets\SmallLogo.png"
            Description="Phira for Windows Phone 8.1"
            ForegroundText="light"
            BackgroundColor="transparent">
            <m3:DefaultTile Wide310x150Logo="Assets\WideLogo.png" Square71x71Logo="Assets\Square71x71Logo.png"/>
            <m3:SplashScreen Image="Assets\SplashScreen.png"/>
        </m3:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClientServer" />
    <!-- Required to *listen* on the LAN rather than only to reach out: without it the in-app log
         server (LogServer.cs) has no channel at all, and reading phirura.log at runtime goes back
         to ISETool plus its mp3 collision. Dev-only in effect - it grants nothing an app on a
         development phone should not have. -->
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>
</Package>