  <!--
    `Assets\demo\` (chart.json + demo.wav) is deliberately NOT packaged any more. The port is
    playable without importing anything because of `Assets\charts\190`, which
    `EnsureBundledChartAsync` copies into phira's own `data/charts/custom/190`, and
    `ChartLibrary` no longer emits the `appx:demo` card that was the only reader of this
    folder. Keeping it would ship ~2.8 MB behind a `ms-appx:///Assets/demo/chart.json` that
    nothing opens any more.
  -->
  <ItemGroup>
    <!--
      Note / hold / hit textures and fonts used by the chart renderer, plus the audio.
      click/drag/flick/cali/cali_hit.wav are Phira's own click.ogg / drag.ogg / flick.ogg /
      cali.ogg / cali_hit.ogg transcoded to 16-bit PCM, because WP8.1's MediaElement has no
      Ogg Vorbis decoder. hold.png is Phira's single-sheet hold atlas (holdAtlas: [50, 50]);
      hit_fx.png is its 8x7 hit-particle atlas.
    -->
    <Content Include="Assets\game\bold.ttf" />
    <Content Include="Assets\game\button.wav" />
    <Content Include="Assets\game\button_large.wav" />
    <Content Include="Assets\game\cali.wav" />
    <Content Include="Assets\game\cali_hit.wav" />
    <Content Include="Assets\game\click.png" />
    <Content Include="Assets\game\click.wav" />
    <Content Include="Assets\game\drag.png" />
    <Content Include="Assets\game\drag.wav" />
    <Content Include="Assets\game\flick.png" />
    <Content Include="Assets\game\flick.wav" />
    <Content Include="Assets\game\hit_fx.png" />
    <Content Include="Assets\game\hold.png" />
    <Content Include="Assets\game\phigros.ttf" />
    <Content Include="Assets\game\switch.wav" />

    <!--
        What the app needs to RUN, shipped inside the package.

        `Assets\respack` is the half phira cannot do without: `font.ttf`, every UI sprite, the
        hit sounds, `rank\`, `mod\`. Real phira makes the player import this as a resource pack
        before it draws anything at all, so a build that shipped without it would not be
        "不需要任何导入资源" - it would be an app that needs an import nobody can perform on a
        phone. `SeedRootAsync` copies it into `LocalFolder\respack` on first launch, which is
        also what makes `stage-chart.ps1 -Push` unnecessary: without that copy a missing push
        showed up on the device as "asset not found", never as a build error.

        Charts are the opposite case and are deliberately NOT shipped. phira reads them from its
        own `data/charts` - downloaded from the online library, or imported by the player - and
        `dir::charts()` creates that tree itself, so an empty library on a fresh phone is a
        working state rather than a broken one. `Assets\charts\` is kept as the hook for
        bundling one: a chart dropped in there ships as soon as its name comes off the
        `Exclude`, and `EnsureBundledChartAsync` will copy it into phira's library on first
        launch.

        Both folders currently under that root are excluded on purpose - `190` (the development
        chart) and `demo` (the second copy of the demo: chart.json + demo.wav + info.yml, the
        same bytes as `Assets\demo\`). Unlike the `appx:demo` card, which `ChartLibrary` has
        stopped emitting, this copy would surface on its own: seeding puts it into
        `LocalFolder\charts` and `ChartLibrary.LoadAllAsync` enumerates that folder and turns
        every entry it finds into a playable card.

        `Exclude` rather than a second item because MSBuild 12 has no `<Content Remove>`, and
        the glob is recursive on purpose so that a chart or an asset added later is packaged
        without a csproj edit - which is exactly why the two names that must not ship have to be
        spelled out here.
    -->
    <Content Include="Assets\charts\**\*" Exclude="Assets\charts\190\**\*;Assets\charts\demo\**\*" />
    <Content Include="Assets\respack\**\*" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Rust native probe. A real ARMNT binary produced by rustc for the custom
      thumbv7a-windows-phone target and linked with the VC11 ARM linker; see rust-wp81/ at the
      workspace root. Kept at the package ROOT on purpose: DllImport resolves against the app
      package root, so a subfolder would need the path spelled out in the DllImport instead.
    -->
    <Content Include="wp81probe.dll" />
    <!-- DllImport resolves against the package root, so both native probes live there. -->
    <Content Include="wp81d3d11.dll" />
    <!-- The real Rust prpr, compiled for WP8.1. Same package-root rule as the probes. -->
    <!-- Conditional: the Rust port is still being brought up, and a missing file in a
         Content item fails the whole build. The app must stay shippable either way. -->
    <Content Include="wp81prpr.dll" Condition="Exists('wp81prpr.dll')" />
    <!-- Path A: the Rust-owned D3D11 renderer (rust-wp81/d3d11-rs-probe/out/wp81d3d11rs.dll).
         Imports only d3d11.dll / dxgi.dll / d3dcompiler_47.dll - all three present on WP8.1.
         Same package-root rule as the other natives. -->
    <Content Include="wp81d3d11rs.dll" Condition="Exists('wp81d3d11rs.dll')" />
  </ItemGroup>
