  <!--
    Win2D (Direct2D) for Windows Phone 8.1. The package is vendored under Phirura\packages
    rather than restored by NuGet, because the 8.1 build here runs from a script and we want
    a reproducible tree.

    The targets file derives the native binary path straight from $(Platform):
        $(MSBuildThisFileDirectory)..\..\bin\Phone\$(Platform)\
    and the package only ships Phone\arm and Phone\x86. There is no AnyCPU and no x64
    for the phone, so building this head with Platform=AnyCPU fails with a missing
    Microsoft.Graphics.Canvas.winmd. Build with Platform=ARM (device) or x86 (emulator).
  -->
  <Import Project="..\..\packages\Win2D.win81.1.21.0\build\wpa\Win2D.win81.targets"
          Condition="Exists('..\..\packages\Win2D.win81.1.21.0\build\wpa\Win2D.win81.targets')" />
