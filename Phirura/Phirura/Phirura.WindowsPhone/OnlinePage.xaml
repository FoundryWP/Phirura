<Page
    x:Class="Phirura.OnlinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Phirura"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#FF0E0E13">

    <Grid Background="#FF0E0E13">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="18,14,18,6">
            <TextBlock Text="在线谱面" FontSize="26" FontWeight="Light" Foreground="#FFF2F2F6" />
            <TextBlock x:Name="AccountText" Text="" FontSize="12" Foreground="#FF8A8A99" Margin="0,3,0,0" />
        </StackPanel>

        <!-- Search -->
        <Grid Grid.Row="1" Margin="18,4,18,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="搜索曲名 / 谱师"
                     KeyDown="SearchBox_KeyDown" />
            <Button Grid.Column="1" Content="搜索" Click="SearchButton_Click" Margin="8,0,0,0" />
            <ComboBox x:Name="OrderBox" Grid.Column="2" Width="104" Margin="8,0,0,0"
                      SelectionChanged="OrderBox_SelectionChanged" />
        </Grid>

        <!-- Results -->
        <ListView x:Name="ChartList" Grid.Row="2" Margin="0,0,0,0"
                  SelectionMode="None" IsItemClickEnabled="False"
                  Background="Transparent">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="12,5,12,5" Padding="14,12,14,12" Background="#FF191922">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding ChartName}" FontSize="18" Foreground="#FFF2F2F6"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#FF8A8A99"
                                           Margin="0,3,0,0" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="#FF7A7A8A"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Border Background="#FF2B2B3A" Padding="10,5,10,5" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding LevelDisplay}" FontSize="14"
                                               Foreground="#FFB9B9C9" />
                                </Border>
                                <Button Content="下载" FontSize="12" Margin="0,8,0,0"
                                        Click="DownloadButton_Click" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Margin="18,6,18,14">
            <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="4"
                         Foreground="#FF8FD4FF" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="#FF7A7A8A"
                       TextWrapping="Wrap" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="PrevButton" Content="上一页" Click="PrevButton_Click" />
                <Button x:Name="NextButton" Content="下一页" Click="NextButton_Click" Margin="10,0,0,0" />
                <Button Content="返回" Click="BackButton_Click" Margin="10,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
