{
  "arch": "arm",
  "abi-return-struct-as-int": true,
  "archive-format": "coff",
  "binary-format": "coff",
  "crt-objects-fallback": "false",
  "crt-static-allows-dylibs": true,
  "crt-static-default": true,
  "crt-static-respected": true,
  "data-layout": "e-m:w-p:32:32-Fi8-i64:64-v128:64:128-a:0:32-n32-S64",
  "debuginfo-kind": "pdb",
  "dll-prefix": "",
  "dll-suffix": ".dll",
  "dll-tls-export": false,
  "dynamic-linking": false,
  "emit-debug-gdb-scripts": false,
  "env": "msvc",
  "exe-suffix": ".exe",
  "features": "+vfp3,+neon,+hwdiv,+hwdiv-arm",
  "has-thread-local": true,
  "is-like-msvc": true,
  "is-like-windows": true,
  "linker-flavor": "msvc",
  "linker-is-gnu": false,
  "lld-flavor": "link",
  "llvm-floatabi": "hard",
  "llvm-target": "thumbv7a-pc-windows-msvc",
  "max-atomic-width": 64,
  "no-default-libraries": false,
  "os": "windows",
  "panic-strategy": "abort",
  "pre-link-args": {
    "msvc": [
      "/NOLOGO",
      "/OPT:NOLBR",
      "/MACHINE:ARM",
      "/SUBSYSTEM:WINDOWS,6.03"
    ]
  },
  "requires-uwtable": true,
  "split-debuginfo": "packed",
  "staticlib-prefix": "",
  "staticlib-suffix": ".lib",
  "supported-split-debuginfo": [
    "packed"
  ],
  "target-family": [
    "windows"
  ],
  "target-pointer-width": 32,
  "vendor": "winphone"
}
